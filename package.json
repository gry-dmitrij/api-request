{
  "name": "@gry-dmitrij/api-request",
  "version": "0.0.16",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "verify": "tsc --noEmit && vitest run",
    "pack:check": "npm pack --dry-run",
    "release": "npm publish --access public",
    "prepublishOnly": "npm run verify && npm run build",
    "prepare": "husky",
    "lint": "lint-staged"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gry-dmitrij/api-request.git"
  },
  "author": "gry-dmitrij",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gry-dmitrij/api-request/issues"
  },
  "homepage": "https://github.com/gry-dmitrij/api-request#readme",
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.14.1",
    "@typescript-eslint/parser": "^8.31.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.25.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.1",
    "msw": "^2.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.31.0",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.2.7"
  }
}
